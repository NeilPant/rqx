{
  "version": "2.1.0",
  "$schema": "http://json.schemastore.org/sarif-2.1.0-rtm.5",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "ESLint",
          "informationUri": "https://eslint.org",
          "rules": [
            {
              "id": "no-unused-vars",
              "helpUri": "https://eslint.org/docs/latest/rules/no-unused-vars",
              "properties": {
                "category": "Variables"
              }
            },
            {
              "id": "no-console",
              "helpUri": "https://eslint.org/docs/latest/rules/no-console",
              "properties": {
                "category": "Possible Problems"
              }
            }
          ]
        }
      },
      "artifacts": [
        {
          "location": {
            "uri": "file://{root}/src/a.js"
          }
        }
      ],
      "results": [
        {
          "level": "error",
          "message": {
            "text": "'unused' is assigned a value but never used."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "file://{root}/src/a.js",
                  "index": 0
                },
                "region": {
                  "startLine": 1,
                  "startColumn": 5,
                  "endLine": 1,
                  "endColumn": 11
                }
              }
            }
          ],
          "ruleId": "no-unused-vars",
          "ruleIndex": 0
        },
        {
          "level": "warning",
          "message": {
            "text": "Unexpected console statement."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "file://{root}/src/a.js",
                  "index": 0
                },
                "region": {
                  "startLine": 2,
                  "startColumn": 1,
                  "endLine": 2,
                  "endColumn": 12
                }
              }
            }
          ],
          "ruleId": "no-console",
          "ruleIndex": 1
        }
      ]
    }
  ]
}
