<idea-plugin>
    <id>com.rqx.rqx</id>
    <name>rqx</name>
    <vendor url="https://github.com/jadhamwi21/rqx">Jad Alhamwi</vendor>

    <description><![CDATA[
      Finds dead code, duplication and architectural drift in TypeScript, Python, Go,
      Java and C++ — and says <em>why</em> each finding matters and <em>what
      refactoring</em> fixes it.
      <br/><br/>
      rqx is a second opinion alongside each language's own server, not a replacement:
      it reports nothing about types or syntax errors. It needs the <code>rqx</code>
      binary on your PATH; the plugin ships none, because one zip carrying five
      platforms would be fifty megabytes for the one you are on.
    ]]></description>

    <depends>com.intellij.modules.platform</depends>
    <depends>com.redhat.devtools.lsp4ij</depends>

    <extensions defaultExtensionNs="com.redhat.devtools.lsp4ij">
        <server id="rqx"
                name="rqx"
                factoryClass="com.rqx.RqxServerFactory">
            <description><![CDATA[Finds dead code, duplication and architectural drift.]]></description>
        </server>
        <languageMapping language="TypeScript" serverId="rqx"/>
        <languageMapping language="TypeScript JSX" serverId="rqx"/>
        <languageMapping language="Python" serverId="rqx"/>
        <languageMapping language="go" serverId="rqx"/>
        <languageMapping language="JAVA" serverId="rqx"/>
        <languageMapping language="ObjectiveC" serverId="rqx"/>
    </extensions>

    <extensions defaultExtensionNs="com.intellij">
        <applicationService serviceImplementation="com.rqx.RqxSettings"/>
        <applicationConfigurable parentId="tools"
                                 id="com.rqx.settings"
                                 displayName="rqx"
                                 instance="com.rqx.RqxConfigurable"/>
    </extensions>

    <!--
      The same leader chord every other editor suggests: one key is claimed rather
      than eight, and the second key means the same thing everywhere.
    -->
    <actions>
        <group id="rqx.menu" text="rqx" popup="true">
            <add-to-group group-id="ToolsMenu" anchor="last"/>
            <action id="rqx.scan" class="com.rqx.ScanWorkspace" text="Scan the Workspace">
                <keyboard-shortcut keymap="$default" first-keystroke="ctrl alt R" second-keystroke="S"/>
                <keyboard-shortcut keymap="Mac OS X 10.5+" first-keystroke="meta alt R" second-keystroke="S"/>
            </action>
            <action id="rqx.check" class="com.rqx.CheckDiff" text="Review the Diff">
                <keyboard-shortcut keymap="$default" first-keystroke="ctrl alt R" second-keystroke="C"/>
                <keyboard-shortcut keymap="Mac OS X 10.5+" first-keystroke="meta alt R" second-keystroke="C"/>
            </action>
            <action id="rqx.startHere" class="com.rqx.StartHere" text="Open What Matters First">
                <keyboard-shortcut keymap="$default" first-keystroke="ctrl alt R" second-keystroke="H"/>
                <keyboard-shortcut keymap="Mac OS X 10.5+" first-keystroke="meta alt R" second-keystroke="H"/>
            </action>
            <action id="rqx.catalogue" class="com.rqx.ShowCatalogue" text="Show the Rule Catalogue"/>
            <separator/>
            <action id="rqx.fix" class="com.rqx.FixWorkspace" text="Apply Every Proven Fix">
                <keyboard-shortcut keymap="$default" first-keystroke="ctrl alt R" second-keystroke="F"/>
                <keyboard-shortcut keymap="Mac OS X 10.5+" first-keystroke="meta alt R" second-keystroke="F"/>
            </action>
            <action id="rqx.verify" class="com.rqx.VerifyRefactoring" text="Verify the Refactoring">
                <keyboard-shortcut keymap="$default" first-keystroke="ctrl alt R" second-keystroke="V"/>
                <keyboard-shortcut keymap="Mac OS X 10.5+" first-keystroke="meta alt R" second-keystroke="V"/>
            </action>
            <action id="rqx.baseline" class="com.rqx.TakeBaseline" text="Take or Update the Baseline"/>
            <separator/>
            <action id="rqx.togglePatterns" class="com.rqx.TogglePatterns" text="Toggle Pattern Advice">
                <keyboard-shortcut keymap="$default" first-keystroke="ctrl alt R" second-keystroke="P"/>
                <keyboard-shortcut keymap="Mac OS X 10.5+" first-keystroke="meta alt R" second-keystroke="P"/>
            </action>
            <action id="rqx.toggleCodeLens" class="com.rqx.ToggleCodeLens" text="Toggle the Code Lens">
                <keyboard-shortcut keymap="$default" first-keystroke="ctrl alt R" second-keystroke="L"/>
                <keyboard-shortcut keymap="Mac OS X 10.5+" first-keystroke="meta alt R" second-keystroke="L"/>
            </action>
            <separator/>
            <action id="rqx.restart" class="com.rqx.RestartServer" text="Restart the Server"/>
        </group>
    </actions>
</idea-plugin>
